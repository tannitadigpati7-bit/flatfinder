{
  "manifest_version": 3,
  "name": "FlatFinder Capture",
  "version": "1.0.0",
  "description": "Right-click a flat listing you're reading (Facebook group, WhatsApp Web, anywhere) and save it to your FlatFinder database in one step.",
  "permissions": ["contextMenus", "storage", "notifications"],
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://router.project-osrm.org/*",
    "https://*.supabase.co/*",
    "https://www.facebook.com/*",
    "https://m.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
      "js": ["content-facebook.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlatFinder Capture"
  }
}
